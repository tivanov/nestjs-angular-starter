{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^config/(.*)$": "<rootDir>/../config/$1",
    "^@app/contracts/(.*)$": "<rootDir>/../libs/contracts/src/$1",
    "^@app/contracts$": "<rootDir>/../libs/contracts/src"
  }
}